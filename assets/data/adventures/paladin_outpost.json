      {
        "id": "outpost_amulet",
        "text": "Командор поддевает шнурок двумя пальцами и рассматривает оберег на свет.\n\n«Я знаю, чьи руки это плели. Оно вас бережёт, не спорю. Только беречь оно вас будет и от нас».",
        "choices": [
          {
            "label": "Отдать оберег — вещь того не стоит",
            "onSuccess": {
              "actions": [
                {
                  "action": "takeItem",
                  "target": "currentPlayer",
                  "itemId": "item_ward_amulet"
                },
                {
                  "action": "setWorldFlag",
                  "flag": "paladin_debt",
                  "value": true
                }
              ],
              "to": {
                "destination": "goToNode",
                "nodeId": "outpost_debt_granted"
              }
            }
          },
