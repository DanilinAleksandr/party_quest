                  "stat": "strength",
                  "amount": 2
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            },
            "onFailure": {
              "actions": [
                {
                  "action": "applyEffect",
                  "target": "currentPlayer",
                  "effectId": "effect_pharaohs_curse"
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      },
      {
        "id": "pharaoh_first_meeting",
        "text": "«Немногие доходят так далеко и не берут ничего. Чего ты хочешь, путник?»",
        "choices": [
          {
            "label": "Попросить сокровища",
            "successChance": 0.5,
            "onSuccess": {
              "actions": [
                {
                  "action": "setWorldFlag",
                  "flag": "found_pharaoh_seal",
                  "value": true
                },
                {
                  "action": "giveItem",
                  "target": "currentPlayer",
                  "itemId": "item_pharaohs_seal"
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            },
            "onFailure": {
              "actions": [
                {
                  "action": "applyEffect",
                  "target": "currentPlayer",
                  "effectId": "effect_pharaohs_curse"
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            }
          },
          {
            "label": "Попросить лишь мудрости",
            "onSuccess": {
              "actions": [
                {
                  "action": "modifyStat",
                  "target": "currentPlayer",
                  "stat": "luck",
                  "amount": 2
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      },
      {
        "id": "pharaoh_recognizes_chosen",
        "text": "Фараон медленно поднимается с трона — впервые за века золото на его плечах сдвигается само.\n\n«Немногие смотрят мне в глаза, не отводя взгляда, — произносит он. — Ещё меньше делают это, потому что имеют на это право».\n\nОн протягивает руку, и печать царства на миг вспыхивает на твоей коже, будто была там всегда. «Боги моего царства отметили твой род задолго до твоего рождения. Я лишь узнаю то, что уже было решено».",
        "onEnterActions": [
          {
            "action": "revealOrigin",
            "originId": "origin_gods_chosen"
          },
          {
            "action": "setWorldFlag",
            "flag": "pharaoh_recognized_chosen",
            "value": true
          },
          {
            "action": "addChronicleEntry",
            "text": "☀️ {player} — Избранник богов."
          }
        ],
        "choices": [
          {
            "label": "Понятно",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      }
    ]
  }
