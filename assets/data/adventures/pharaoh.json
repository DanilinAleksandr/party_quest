[
  {
    "id": "pharaoh",
    "entryNodeId": "pharaoh_deeper_passage",
    "nodes": [
      {
        "id": "pharaoh_deeper_passage",
        "text": "За тем залом, где ты уже когда-то бывал, находится ещё один проход — глубже, темнее, старше.",
        "choices": [
          {
            "label": "Спуститься глубже",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "pharaoh_throne_room"
              }
            }
          },
          {
            "label": "Достаточно на сегодня",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      },
      {
        "id": "pharaoh_throne_room",
        "text": "Тронный зал. На троне — фигура, обёрнутая золотом и временем. Она поднимает голову.",
        "choices": [
          {
            "label": "Встретить его взгляд, не склоняя головы",
            "conditions": [
              {
                "condition": "currentPlayerOriginUnknown"
              }
            ],
            "successChance": 0.1,
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "pharaoh_recognizes_chosen"
              }
            },
            "onFailure": {
              "actions": [
                {
                  "action": "applyEffect",
                  "target": "currentPlayer",
                  "effectId": "effect_pharaohs_curse"
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            }
          },
          {
            "label": "«Ты носишь мою печать...»",
            "conditions": [
              {
                "condition": "worldFlagSet",
                "flag": "found_pharaoh_seal"
              }
            ],
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "pharaoh_recognizes_seal"
              }
            }
          },
          {
            "label": "Фараон молча указывает на пустой постамент рядом с троном",
            "conditions": [
              {
                "condition": "worldFlagUnset",
                "flag": "found_pharaoh_seal"
              }
            ],
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "pharaoh_first_meeting"
              }
            }
          }
        ]
      },
      {
        "id": "pharaoh_recognizes_seal",
        "text": "«Верни то, что взял — или докажи, что достоин носить это».",
        "choices": [
          {
            "label": "Вернуть печать",
            "conditions": [
              {
                "condition": "currentPlayerHasItem",
                "itemId": "item_pharaohs_seal"
              }
            ],
            "onSuccess": {
              "actions": [
                {
                  "action": "takeItem",
                  "target": "currentPlayer",
                  "itemId": "item_pharaohs_seal"
                },
                {
                  "action": "setWorldFlag",
                  "flag": "returned_pharaoh_seal",
                  "value": true
                },
                {
                  "action": "giveItem",
                  "target": "currentPlayer",
                  "itemId": "item_ward_amulet"
                },
                {
                  "action": "applyEffect",
                  "target": "currentPlayer",
                  "effectId": "effect_mystery"
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            }
          },
          {
            "label": "Доказать, что достоин",
            "successChance": 0.5,
            "onSuccess": {
              "actions": [
                {
                  "action": "setWorldFlag",
                  "flag": "earned_pharaoh_respect",
                  "value": true
                },
                {
                  "action": "modifyStat",
