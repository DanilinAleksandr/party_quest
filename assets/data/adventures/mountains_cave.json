            "onSuccess": { "actions": [], "to": { "destination": "endAdventure" } }
          }
        ]
      },
      {
        "id": "cave_in",
        "text": "Камень под ногой предательски сдвигается — сверху сыплется мелкая крошка, и приходится поспешно выбираться наружу, оставив блеск позади.",
        "onEnterActions": [
