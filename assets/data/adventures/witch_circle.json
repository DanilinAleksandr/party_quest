      {
        "id": "circle_welcome",
        "text": "Старуха коротко смеётся, и напряжение спадает по всему кругу.\n\n«Кого орден гонит, того мы кормим. Садитесь».\n\nВас усаживают к огню и разговаривают с вами как со своими — долго, до самого рассвета.",
        "onEnterActions": [
          {
            "action": "setWorldFlag",
            "flag": "circle_ally",
            "value": true
          },
          {
            "action": "addChronicleEntry",
            "text": "🔮 Компания принята ведьмовским кругом."
          }
        ],
        "choices": [
          {
            "label": "Понятно",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
