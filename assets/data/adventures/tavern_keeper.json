    "nodes": [
      {
        "id": "keeper_private_room",
        "text": "Хозяин таверны, которого ты прежде ни разу не замечал среди завсегдатаев, манит тебя жестом в заднюю комнату.",
        "choices": [
          {
            "label": "Пройти за ним",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "keeper_offer"
              }
            }
          },
          {
            "label": "Остаться за общим столом",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      },
      {
        "id": "keeper_offer",
        "text": "«Я держу эту таверну дольше, чем кто-либо здесь помнит. И у меня кое-что есть для тебя».",
        "choices": [
          {
            "label": "Присмотреться внимательнее к его глазам",
            "conditions": [
