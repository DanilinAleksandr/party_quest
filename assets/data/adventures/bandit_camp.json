            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_bribe_roll"
              }
            }
          }
        ]
      },
      {
        "id": "camp_sneak_success",
        "text": "Ты проскальзываешь мимо, никем не замеченный, и добираешься до самого шатра атамана. Внутри — сундук с трофеями.",
        "choices": [
          {
            "label": "Взять и бежать",
            "onSuccess": {
              "actions": [
                {
                  "action": "setWorldFlag",
                  "flag": "raided_bandit_camp",
                  "value": true
                },
                {
                  "action": "giveItem",
                  "target": "currentPlayer",
                  "itemId": "item_dice_of_fate"
                },
                {
                  "action": "addChronicleEntry",
                  "text": "🏴 Компания ограбила лагерь бандитов."
                }
              ],
              "to": {
                "destination": "endAdventure"
              }
            }
          },
          {
            "label": "Не рисковать, тихо уйти",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      },
      {
        "id": "camp_caught",
        "text": "Часовой замечает тебя и поднимает тревогу! Из палаток высыпают разбойники.",
