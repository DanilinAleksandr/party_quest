                "destination": "goToNode",
                "nodeId": "camp_confrontation"
              }
            }
          }
        ]
      },
      {
        "id": "camp_talk",
        "text": "Ты выходишь на свет с поднятыми руками. Атаман лагеря, хмурый детина со шрамом через бровь, оглядывает тебя с прищуром.",
        "choices": [
          {
            "label": "Дать понять, что тоже вне закона",
            "conditions": [
              {
                "condition": "currentPlayerHasOrigin",
                "originId": "origin_fugitive"
              }
            ],
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_let_go"
              }
            }
          },
          {
            "label": "Попросить пропустить с миром",
            "successChance": 0.5,
