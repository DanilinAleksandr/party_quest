[
  {
    "id": "bandit_camp",
    "entryNodeId": "camp_sighted",
    "nodes": [
      {
        "id": "camp_sighted",
        "text": "Сквозь деревья виден дым костра и силуэты вооружённых людей — разбойничий лагерь на другой стороне поляны.",
        "choices": [
          {
            "label": "Подобраться ближе",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_approach"
              }
            }
          },
          {
            "label": "Обойти лагерь стороной",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "endAdventure"
              }
            }
          }
        ]
      },
      {
        "id": "camp_approach",
        "text": "Ты подбираешься ближе. Часовой прохаживается у самой границы лагеря, вот-вот тебя заметит. Как действовать?",
        "choices": [
          {
            "label": "Прокрасться мимо часового",
            "successChance": 0.5,
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_sneak_success"
              }
            },
            "onFailure": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_caught"
              }
            }
          },
          {
            "label": "Выйти открыто и заговорить",
            "onSuccess": {
              "actions": [],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_talk"
              }
            }
          },
          {
            "label": "Атаковать в лоб",
            "conditions": [
              {
                "condition": "currentPlayerHasItem",
                "itemId": "item_bravery_flask"
              }
            ],
            "onSuccess": {
              "actions": [
                {
                  "action": "takeItem",
                  "target": "currentPlayer",
                  "itemId": "item_bravery_flask"
                }
              ],
              "to": {
                "destination": "goToNode",
                "nodeId": "camp_attack_roll"
              }
            }
          },
          {
            "label": "Предложить бочонок вместо драки",
            "conditions": [
              {
                "condition": "partyHasItem",
                "itemId": "item_beer_keg"
              }
